{
  "name": "ryppl-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the Ryppl API + the sanitized-AI-context schema. Codegen → Dart / Java / TS.",
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "preview": "redocly preview-docs openapi.yaml",
    "bundle": "redocly bundle openapi.yaml -o dist/openapi.bundled.yaml",
    "gen:dart": "openapi-generator-cli generate -i openapi.yaml -g dart-dio -o gen/dart --additional-properties=pubName=ryppl_api",
    "gen:java": "openapi-generator-cli generate -i openapi.yaml -g spring -o gen/java --additional-properties=basePackage=com.ryppl.api,interfaceOnly=true",
    "gen:ts": "openapi-generator-cli generate -i openapi.yaml -g typescript-angular -o gen/ts"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0",
    "@openapitools/openapi-generator-cli": "^2.13.0"
  }
}
